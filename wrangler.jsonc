/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rownative-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-10",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "ROWING_COURSES",
			"id": "4ff6414c50eb410e8543e261a235091e",
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rowing-courses-db",
			"database_id": "d75bb201-4c38-460f-8d9a-e97e69f5323e",
			"migrations_dir": "migrations"
		}
	],
	"routes": [
		{ "pattern": "rownative.icu/api/*", "zone_name": "rownative.icu" },
		{ "pattern": "rownative.icu/oauth/*", "zone_name": "rownative.icu" }
	],
	/**
	 * Default bindings so `env.INTERVALS_*` is never undefined (avoids client_id=undefined in OAuth URLs).
	 * Production: override with `wrangler secret put` (secrets take precedence).
	 * Local real OAuth: use `.dev.vars` with real intervals.icu credentials (overrides these defaults).
	 */
	"vars": {
		"INTERVALS_CLIENT_ID": "configure-via-secret-or-dev-vars",
		"INTERVALS_CLIENT_SECRET": "configure-via-secret-or-dev-vars",
		"TOKEN_ENCRYPTION_KEY": "00000000000000000000000000000000"
	}
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 *
	 * Required for import-zip: GITHUB_TOKEN (set via `wrangler secret put GITHUB_TOKEN`).
	 * Optional: GITHUB_REPO (default: rownative/courses).
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}